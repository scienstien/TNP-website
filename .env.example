# Fictional local development credentials. Replace them in your untracked .env.
POSTGRES_DB=tnp_dashboard
POSTGRES_USER=tnp_user
POSTGRES_PASSWORD=tnp_password
POSTGRES_PORT=5432

# Keep this URL aligned with the PostgreSQL values above.
DATABASE_URL=postgresql://tnp_user:tnp_password@localhost:5432/tnp_dashboard

# Required. Encrypts session cookies. Generate one with: npx auth secret
AUTH_SECRET=11111111111111111111111111

# Comma-separated email domains allowed to create (read-only) professor accounts.
ALLOWED_SIGNUP_DOMAINS=nitt.edu

# Local troubleshooting only: view dashboard pages as a read-only professor.
# This flag is ignored in production.
# AUTH_BYPASS=true

# Production only: set when the app runs behind a proxy/host not auto-detected by Auth.js.
# AUTH_TRUST_HOST=true

# Production only, and only on purpose: create the development accounts (superadmin / test123,
# admin123<dept>@nitt.edu / test1234).
# They are always created in development. Never enable this on a public deployment.
# SEED_TRIAL_ADMIN=true
