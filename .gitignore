# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/dist/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# vercel
.vercel
/.turbo/

# package-manager and tool caches
/.npm/
/.pnpm-store/
/.cache/
.eslintcache

# editors and operating systems
/.vscode/
/.idea/
*.swp
*.swo
*.code-workspace
Thumbs.db
desktop.ini

# temporary files and reports
/logs/
/reports/
/placed-so-far-handoff/
/.nyc_output/
*.tmp
*.temp
*.bak
*.old
*~

# typescript
*.tsbuildinfo
next-env.d.ts
